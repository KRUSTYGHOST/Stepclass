# Database
DATABASE_URL=sqlite:///./mediconnect.db
# For PostgreSQL: postgresql://user:password@localhost/mediconnect
# For MySQL: mysql+pymysql://user:password@localhost/mediconnect

# Security
SECRET_KEY=your-secret-key-change-in-production-use-random-string

# Email (SendGrid)
SENDGRID_API_KEY=your-sendgrid-api-key
FROM_EMAIL=noreply@mediconnect.com

# SMS (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
